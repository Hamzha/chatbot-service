# Runtime
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8001

# Chat / answer generation: openai | ollama (OpenAI API vs local Ollama `/api/generate`).
MODEL_PROVIDER=openai

# Where **embeddings** are built (RAG ingest + query). Optional.
# If you leave EMBEDDING_BACKEND unset, it follows MODEL_PROVIDER only:
#   MODEL_PROVIDER=openai  → OpenAI Embeddings API (uses OPENAI_* + EMBEDDING_MODEL below).
#   MODEL_PROVIDER=ollama  → Ollama `/api/embeddings` (uses OLLAMA_* + OLLAMA_EMBEDDING_MODEL or fallbacks).
# To use OpenRouter for embeddings while keeping Ollama or OpenAI for chat, set explicitly:
#   EMBEDDING_BACKEND=openrouter
#   OPEN_ROUTER_API_KEY=...
#   OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
#   OPEN_ROUTER_BASE_URL=https://openrouter.ai/api/v1
# Local Ollama embeddings only (when you want them explicit instead of mirroring MODEL_PROVIDER):
#   EMBEDDING_BACKEND=ollama
#   OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# OpenAI
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
# OpenAI embedding model id (used when MODEL_PROVIDER=openai and EMBEDDING_BACKEND is unset or openai).
EMBEDDING_MODEL=text-embedding-3-small

# Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen2.5:14b
# Default Ollama embedding model if OLLAMA_EMBEDDING_MODEL and EMBEDDING_MODEL are both empty.
OLLAMA_EMBED_MODEL=nomic-embed-text
# Embeddings (per request)
OLLAMA_TIMEOUT_SECONDS=180
# Chat `/api/generate` read timeout — increase if you see ReadTimeout (large local models)
OLLAMA_GENERATE_TIMEOUT_SECONDS=600

# Vector store
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION=chatbot_chunks

# Inngest
INNGEST_APP_ID=chatbot_engine
INNGEST_API_BASE_URL=http://127.0.0.1:8288/v1
INNGEST_EVENT_API_BASE_URL=http://127.0.0.1:8288/
