# =============================================================================
# App
# =============================================================================
APP_NAME=Model Gateway API
APP_ENV=development
APP_VERSION=0.1.0
API_PREFIX=/api

# =============================================================================
# OpenRouter — chat / completions (always used for gateway chat + RAG answers)
# =============================================================================
OPEN_ROUTER_API_KEY=
OPEN_ROUTER_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_MODEL=openai/gpt-oss-120b:free

# =============================================================================
# Embeddings — RAG vector index only (pick one backend)
# =============================================================================
# EMBEDDING_BACKEND: openrouter | ollama
#   openrouter → hosted /v1/embeddings; set EMBEDDING_MODEL to an OpenRouter embedding slug.
#   ollama     → local /api/embeddings; set OLLAMA_BASE_URL and OLLAMA_EMBEDDING_MODEL.
EMBEDDING_BACKEND=openrouter

# --- OpenRouter embeddings (when EMBEDDING_BACKEND=openrouter) ---
EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free

# --- Ollama / local embeddings (when EMBEDDING_BACKEND=ollama) ---
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# =============================================================================
# RAG storage (Chroma)
# =============================================================================
# CHROMA_PERSIST_DIR=
CHROMA_COLLECTION=chatbot_chunks
MAX_UPLOAD_SIZE_BYTES=10485760
