# Auth
# Long random secret used to sign JWTs — generate with `openssl rand -hex 64`
JWT_SECRET=replace-with-a-long-random-secret
# Access token lifetime in seconds (3600 = 1 hour)
JWT_EXPIRES_IN_SECONDS=3600
# Cost factor for bcrypt password hashing (10 is a sane default)
BCRYPT_SALT_ROUNDS=10

# Google OAuth (optional — enables "Continue with Google" on login/signup)
# Create a Web client in Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override; defaults to `${NEXT_PUBLIC_APP_URL}/api/auth/google/callback`
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Database
# MongoDB connection string (e.g. mongodb+srv://user:pass@cluster/...)
MONGODB_URI=
# Database name to use within the MongoDB cluster
MONGODB_DB_NAME=

# Email (Resend)
# API key from https://resend.com used to send transactional emails
RESEND_API_KEY=
# From address for outbound emails (must be a verified Resend sender)
EMAIL_FROM=

# App
# Public URL of the web app — used in emails and absolute redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Route chat, ingest, scrape→vectors, and document deletes to chatbot-api when true;
# otherwise model-gateway-api (sync RAG; no Inngest for ingest).
USE_CHATBOT_API=false

# Stripe billing (subscriptions)
# Secret key from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Webhook signing secret from `stripe listen --forward-to localhost:3000/api/billing/webhook`
STRIPE_WEBHOOK_SECRET=
# Plans are created in Admin → Subscription plans and synced to Stripe (no STRIPE_PRICE_* env needed).
