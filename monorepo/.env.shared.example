# =============================================================================
# monorepo/.env.shared (copy from this file; real .env.shared is gitignored)
# =============================================================================
# Loaded first by: apps/chatbot-api, apps/model-gateway-api (before each app's
# .env / .env.local). Same variable name in an app overwrites these values.
# Put shared, non-secret defaults here; keep API keys in apps/*/.env.local.
#
# chatbot-api: If EMBEDDING_BACKEND is unset, embeddings follow MODEL_PROVIDER
#   (openai or ollama only). Set EMBEDDING_BACKEND=openrouter to use hosted embeds.
# model-gateway-api: Chat always uses OpenRouter; embeddings use EMBEDDING_BACKEND
#   (openrouter vs ollama). See that app's .env.example for details.
# Vector dimensions must match ingest + query; change model → usually re-index.

# =============================================================================
# Optional — shared OpenRouter defaults (keys often live in per-app .env.local)
# =============================================================================
# OPEN_ROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPEN_ROUTER_API_KEY=

# =============================================================================
# Embeddings — uncomment ONE block (shared intent for both Python RAG services)
# =============================================================================

# --- A) OpenRouter / hosted embeddings ---
# EMBEDDING_BACKEND=openrouter
# EMBEDDING_MODEL=openai/text-embedding-3-small
# chatbot-api (explicit OpenRouter embed slug — overrides EMBEDDING_MODEL if both set in app):
# OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# --- B) Ollama / local embeddings ---
# EMBEDDING_BACKEND=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# =============================================================================
# Optional — shared Chroma layout
# =============================================================================
# CHROMA_COLLECTION=chatbot_chunks
# CHROMA_PERSIST_DIR=
